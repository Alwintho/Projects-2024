
// Guess the number in 7 tries to figure out the random number between(1-100)
// The program will give you hints wether you are higher or lower than the number

import random

while True: 
    print("Guess the number from 1-100, you have 7 tries!")
    tries=1 
    guess=0 
    number = random.randint(1,100) # creates the randomly generated number

    while tries < 7:
        guess=int(input("Try " + str(tries) + ": "))
        tries+=1
        if guess < number:
            print("Too low!")
        elif guess > number: 
            print("Too high!")
        else:
            break
    if guess == number:
        print("You got it! Only took you " + str(tries-1) +" tries!")
    else:
        print("Sorry, you didn't get it, the number was "+ str(number))

    reset = input("Do you want to try again? (Y/N)").upper() 
    if reset == 'y':
        print("==================") # to distinguish between rounds
        continue
    else: 
        print("Bye-Bye!")
        break
